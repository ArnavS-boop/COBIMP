>>SOURCE FORMAT IS FREE

IDENTIFICATION DIVISION.
PROGRAM-ID. LEXER.

DATA DIVISION.

WORKING-STORAGE SECTION.

    COPY "compiler-defs.cpy".

    01 SOURCE-TEXT        PIC X(10000).
    01 SOURCE-LENGTH      PIC 9(5).

    01 CURRENT-POSITION   PIC 9(5) VALUE 1.
    01 CURRENT-LINE       PIC 9(5) VALUE 1.
    01 CURRENT-COLUMN     PIC 9(5) VALUE 1.

    01 CURRENT-CHAR       PIC X.
    01 NEXT-CHAR          PIC X.

    01 TOKEN-VALUE        PIC X(64).
    01 TOKEN-LENGTH       PIC 9(5) VALUE 0.
    01 TOKEN-START-LINE   PIC 9(5) VALUE 1.
    01 TOKEN-START-COLUMN PIC 9(5) VALUE 1.

    01 TOKEN-COUNT        PIC 9(5) VALUE 0.

    01 LEXICAL-ERROR      PIC X VALUE "N".

    01 DIGIT-FLAG         PIC X VALUE "N".
    01 LETTER-FLAG        PIC X VALUE "N".

    01 TOKEN-TABLE.
        05 TOKEN-ENTRY OCCURS 10001 TIMES.
            10 TOKEN-KIND     PIC 9(3).
            10 TOKEN-TEXT     PIC X(64).
            10 TOKEN-LINE     PIC 9(5).
            10 TOKEN-COLUMN   PIC 9(5).

LINKAGE SECTION.

    01 INPUT-SOURCE        PIC X(10000).
    01 INPUT-LENGTH        PIC 9(5).

    01 OUTPUT-TOKEN-COUNT   PIC 9(5).

    01 OUTPUT-TOKEN-TABLE.
        05 OUTPUT-TOKEN-ENTRY OCCURS 10001 TIMES.
            10 OUTPUT-TOKEN-KIND     PIC 9(3).
            10 OUTPUT-TOKEN-TEXT     PIC X(64).
            10 OUTPUT-TOKEN-LINE     PIC 9(5).
            10 OUTPUT-TOKEN-COLUMN   PIC 9(5).

PROCEDURE DIVISION USING
    INPUT-SOURCE
    INPUT-LENGTH
    OUTPUT-TOKEN-COUNT
    OUTPUT-TOKEN-TABLE.

    MOVE INPUT-SOURCE TO SOURCE-TEXT.
    MOVE INPUT-LENGTH TO SOURCE-LENGTH.

    MOVE 1 TO CURRENT-POSITION.
    MOVE 1 TO CURRENT-LINE.
    MOVE 1 TO CURRENT-COLUMN.
    MOVE 0 TO TOKEN-COUNT.
    MOVE "N" TO LEXICAL-ERROR.

    PERFORM LEX-SOURCE.

    IF LEXICAL-ERROR = "N"

        PERFORM EXPORT-TOKENS

    END-IF.

    GOBACK.


LEX-SOURCE.

    PERFORM UNTIL CURRENT-POSITION > SOURCE-LENGTH
        OR LEXICAL-ERROR = "Y"

        MOVE SOURCE-TEXT(CURRENT-POSITION:1)
            TO CURRENT-CHAR

        EVALUATE TRUE

            WHEN CURRENT-CHAR = SPACE OR CURRENT-CHAR = X"09" OR CURRENT-CHAR = X"0D"
                ADD 1 TO CURRENT-POSITION
                ADD 1 TO CURRENT-COLUMN

            WHEN CURRENT-CHAR = X"0A"
                ADD 1 TO CURRENT-POSITION
                ADD 1 TO CURRENT-LINE
                MOVE 1 TO CURRENT-COLUMN

            WHEN CURRENT-CHAR = ";"
                PERFORM ADD-SEMICOLON-TOKEN
                ADD 1 TO CURRENT-POSITION
                ADD 1 TO CURRENT-COLUMN

            WHEN CURRENT-CHAR = "="
                PERFORM READ-EQUAL

            WHEN CURRENT-CHAR = "+"
                PERFORM ADD-PLUS-TOKEN
                ADD 1 TO CURRENT-POSITION
                ADD 1 TO CURRENT-COLUMN

            WHEN CURRENT-CHAR = "-"
                PERFORM ADD-MINUS-TOKEN
                ADD 1 TO CURRENT-POSITION
                ADD 1 TO CURRENT-COLUMN

            WHEN CURRENT-CHAR = "*"
                PERFORM ADD-MULTIPLY-TOKEN
                ADD 1 TO CURRENT-POSITION
                ADD 1 TO CURRENT-COLUMN

            WHEN CURRENT-CHAR = "/"
                PERFORM ADD-DIVIDE-TOKEN
                ADD 1 TO CURRENT-POSITION
                ADD 1 TO CURRENT-COLUMN

            WHEN CURRENT-CHAR = "("
                PERFORM ADD-LPAREN-TOKEN
                ADD 1 TO CURRENT-POSITION
                ADD 1 TO CURRENT-COLUMN

            WHEN CURRENT-CHAR = ")"
                PERFORM ADD-RPAREN-TOKEN
                ADD 1 TO CURRENT-POSITION
                ADD 1 TO CURRENT-COLUMN

            WHEN CURRENT-CHAR = "{"
                PERFORM ADD-LBRACE-TOKEN
                ADD 1 TO CURRENT-POSITION
                ADD 1 TO CURRENT-COLUMN

            WHEN CURRENT-CHAR = "}"
                PERFORM ADD-RBRACE-TOKEN
                ADD 1 TO CURRENT-POSITION
                ADD 1 TO CURRENT-COLUMN

            WHEN CURRENT-CHAR = "!"
                PERFORM READ-NOT-EQUAL

            WHEN CURRENT-CHAR = "<"
                PERFORM READ-LESS

            WHEN CURRENT-CHAR = ">"
                PERFORM READ-GREATER

            WHEN OTHER

                MOVE "N" TO DIGIT-FLAG
                MOVE "N" TO LETTER-FLAG

                IF CURRENT-CHAR >= "0"
                   AND CURRENT-CHAR <= "9"
                    MOVE "Y" TO DIGIT-FLAG
                END-IF

                IF (CURRENT-CHAR >= "A"
                    AND CURRENT-CHAR <= "Z")
                   OR
                   (CURRENT-CHAR >= "a"
                    AND CURRENT-CHAR <= "z")
                    MOVE "Y" TO LETTER-FLAG
                END-IF

                IF DIGIT-FLAG = "Y"
                    PERFORM READ-NUMBER
                ELSE
                    IF LETTER-FLAG = "Y"
                        PERFORM READ-WORD
                    ELSE
                        PERFORM REPORT-LEXICAL-ERROR
                    END-IF
                END-IF

        END-EVALUATE

    END-PERFORM.

    IF LEXICAL-ERROR = "N"
        ADD 1 TO TOKEN-COUNT

        MOVE TOKEN-EOF
            TO TOKEN-KIND(TOKEN-COUNT)

        MOVE "EOF"
            TO TOKEN-TEXT(TOKEN-COUNT)

        MOVE CURRENT-LINE
            TO TOKEN-LINE(TOKEN-COUNT)

        MOVE CURRENT-COLUMN
            TO TOKEN-COLUMN(TOKEN-COUNT)
    END-IF.


READ-NUMBER.

    MOVE CURRENT-LINE TO TOKEN-START-LINE.
    MOVE CURRENT-COLUMN TO TOKEN-START-COLUMN.
    MOVE SPACES TO TOKEN-VALUE.
    MOVE 0 TO TOKEN-LENGTH.

    PERFORM UNTIL CURRENT-POSITION > SOURCE-LENGTH
        OR LEXICAL-ERROR = "Y"

        MOVE SOURCE-TEXT(CURRENT-POSITION:1)
            TO CURRENT-CHAR

        IF CURRENT-CHAR >= "0"
           AND CURRENT-CHAR <= "9"

            IF TOKEN-LENGTH >= 64
                PERFORM REPORT-LEXICAL-ERROR
                EXIT PERFORM
            END-IF

            ADD 1 TO TOKEN-LENGTH

            MOVE CURRENT-CHAR
                TO TOKEN-VALUE(TOKEN-LENGTH:1)

            ADD 1 TO CURRENT-POSITION
            ADD 1 TO CURRENT-COLUMN

        ELSE
            EXIT PERFORM
        END-IF

    END-PERFORM.

    ADD 1 TO TOKEN-COUNT

    MOVE TOKEN-INTEGER
        TO TOKEN-KIND(TOKEN-COUNT)

    MOVE TOKEN-VALUE
        TO TOKEN-TEXT(TOKEN-COUNT)

    MOVE TOKEN-START-LINE
        TO TOKEN-LINE(TOKEN-COUNT)

    MOVE TOKEN-START-COLUMN
        TO TOKEN-COLUMN(TOKEN-COUNT).


READ-WORD.

    MOVE CURRENT-LINE TO TOKEN-START-LINE.
    MOVE CURRENT-COLUMN TO TOKEN-START-COLUMN.
    MOVE SPACES TO TOKEN-VALUE.
    MOVE 0 TO TOKEN-LENGTH.

    PERFORM UNTIL CURRENT-POSITION > SOURCE-LENGTH
        OR LEXICAL-ERROR = "Y"

        MOVE SOURCE-TEXT(CURRENT-POSITION:1)
            TO CURRENT-CHAR

        IF (CURRENT-CHAR >= "A"
            AND CURRENT-CHAR <= "Z")
           OR
           (CURRENT-CHAR >= "a"
            AND CURRENT-CHAR <= "z")
           OR CURRENT-CHAR = "_"
           OR (CURRENT-CHAR >= "0"
               AND CURRENT-CHAR <= "9")

            IF TOKEN-LENGTH >= 64
                PERFORM REPORT-LEXICAL-ERROR
                EXIT PERFORM
            END-IF

            ADD 1 TO TOKEN-LENGTH

            MOVE CURRENT-CHAR
                TO TOKEN-VALUE(TOKEN-LENGTH:1)

            ADD 1 TO CURRENT-POSITION
            ADD 1 TO CURRENT-COLUMN

        ELSE
            EXIT PERFORM
        END-IF

    END-PERFORM.

    ADD 1 TO TOKEN-COUNT

    MOVE TOKEN-IDENTIFIER
        TO TOKEN-KIND(TOKEN-COUNT)

    MOVE TOKEN-VALUE
        TO TOKEN-TEXT(TOKEN-COUNT)

    MOVE TOKEN-START-LINE
        TO TOKEN-LINE(TOKEN-COUNT)

    MOVE TOKEN-START-COLUMN
        TO TOKEN-COLUMN(TOKEN-COUNT).

       IF FUNCTION TRIM(TOKEN-VALUE) = "print"
           MOVE TOKEN-PRINT
               TO TOKEN-KIND(TOKEN-COUNT)
       END-IF
       
       IF FUNCTION TRIM(TOKEN-VALUE) = "if"
           MOVE TOKEN-IF
               TO TOKEN-KIND(TOKEN-COUNT)
       END-IF
       
       IF FUNCTION TRIM(TOKEN-VALUE) = "else"
           MOVE TOKEN-ELSE
               TO TOKEN-KIND(TOKEN-COUNT)
       END-IF.

    IF FUNCTION TRIM(TOKEN-VALUE) = "while"
        MOVE TOKEN-WHILE TO TOKEN-KIND(TOKEN-COUNT)
    END-IF.

    IF FUNCTION TRIM(TOKEN-VALUE) = "let"
        MOVE TOKEN-LET
            TO TOKEN-KIND(TOKEN-COUNT)
    END-IF.


READ-EQUAL.

    IF CURRENT-POSITION < SOURCE-LENGTH
        MOVE SOURCE-TEXT(CURRENT-POSITION + 1:1)
            TO NEXT-CHAR
    ELSE
        MOVE SPACE TO NEXT-CHAR
    END-IF.

    IF NEXT-CHAR = "="

        ADD 1 TO TOKEN-COUNT

        MOVE TOKEN-EQUAL
            TO TOKEN-KIND(TOKEN-COUNT)

        MOVE "=="
            TO TOKEN-TEXT(TOKEN-COUNT)

        MOVE CURRENT-LINE
            TO TOKEN-LINE(TOKEN-COUNT)

        MOVE CURRENT-COLUMN
            TO TOKEN-COLUMN(TOKEN-COUNT)

        ADD 2 TO CURRENT-POSITION
        ADD 2 TO CURRENT-COLUMN

    ELSE

        PERFORM ADD-ASSIGN-TOKEN

        ADD 1 TO CURRENT-POSITION
        ADD 1 TO CURRENT-COLUMN

    END-IF.


READ-NOT-EQUAL.

    IF CURRENT-POSITION < SOURCE-LENGTH
        MOVE SOURCE-TEXT(CURRENT-POSITION + 1:1)
            TO NEXT-CHAR
    ELSE
        MOVE SPACE TO NEXT-CHAR
    END-IF.

    IF NEXT-CHAR = "="

        ADD 1 TO TOKEN-COUNT

        MOVE TOKEN-NOT-EQUAL
            TO TOKEN-KIND(TOKEN-COUNT)

        MOVE "!="
            TO TOKEN-TEXT(TOKEN-COUNT)

        MOVE CURRENT-LINE
            TO TOKEN-LINE(TOKEN-COUNT)

        MOVE CURRENT-COLUMN
            TO TOKEN-COLUMN(TOKEN-COUNT)

        ADD 2 TO CURRENT-POSITION
        ADD 2 TO CURRENT-COLUMN

    ELSE

        PERFORM REPORT-LEXICAL-ERROR

    END-IF.


READ-LESS.

    IF CURRENT-POSITION < SOURCE-LENGTH
        MOVE SOURCE-TEXT(CURRENT-POSITION + 1:1)
            TO NEXT-CHAR
    ELSE
        MOVE SPACE TO NEXT-CHAR
    END-IF.

    IF NEXT-CHAR = "="

        ADD 1 TO TOKEN-COUNT

        MOVE TOKEN-LESS-EQUAL
            TO TOKEN-KIND(TOKEN-COUNT)

        MOVE "<="
            TO TOKEN-TEXT(TOKEN-COUNT)

        MOVE CURRENT-LINE
            TO TOKEN-LINE(TOKEN-COUNT)

        MOVE CURRENT-COLUMN
            TO TOKEN-COLUMN(TOKEN-COUNT)

        ADD 2 TO CURRENT-POSITION
        ADD 2 TO CURRENT-COLUMN

    ELSE

        ADD 1 TO TOKEN-COUNT

        MOVE TOKEN-LESS
            TO TOKEN-KIND(TOKEN-COUNT)

        MOVE "<"
            TO TOKEN-TEXT(TOKEN-COUNT)

        MOVE CURRENT-LINE
            TO TOKEN-LINE(TOKEN-COUNT)

        MOVE CURRENT-COLUMN
            TO TOKEN-COLUMN(TOKEN-COUNT)

        ADD 1 TO CURRENT-POSITION
        ADD 1 TO CURRENT-COLUMN

    END-IF.


READ-GREATER.

    IF CURRENT-POSITION < SOURCE-LENGTH
        MOVE SOURCE-TEXT(CURRENT-POSITION + 1:1)
            TO NEXT-CHAR
    ELSE
        MOVE SPACE TO NEXT-CHAR
    END-IF.

    IF NEXT-CHAR = "="

        ADD 1 TO TOKEN-COUNT

        MOVE TOKEN-GREATER-EQUAL
            TO TOKEN-KIND(TOKEN-COUNT)

        MOVE ">="
            TO TOKEN-TEXT(TOKEN-COUNT)

        MOVE CURRENT-LINE
            TO TOKEN-LINE(TOKEN-COUNT)

        MOVE CURRENT-COLUMN
            TO TOKEN-COLUMN(TOKEN-COUNT)

        ADD 2 TO CURRENT-POSITION
        ADD 2 TO CURRENT-COLUMN

    ELSE

        ADD 1 TO TOKEN-COUNT

        MOVE TOKEN-GREATER
            TO TOKEN-KIND(TOKEN-COUNT)

        MOVE ">"
            TO TOKEN-TEXT(TOKEN-COUNT)

        MOVE CURRENT-LINE
            TO TOKEN-LINE(TOKEN-COUNT)

        MOVE CURRENT-COLUMN
            TO TOKEN-COLUMN(TOKEN-COUNT)

        ADD 1 TO CURRENT-POSITION
        ADD 1 TO CURRENT-COLUMN

    END-IF.


ADD-SEMICOLON-TOKEN.

    ADD 1 TO TOKEN-COUNT.

    MOVE TOKEN-SEMICOLON
        TO TOKEN-KIND(TOKEN-COUNT).

    MOVE ";"
        TO TOKEN-TEXT(TOKEN-COUNT).

    MOVE CURRENT-LINE
        TO TOKEN-LINE(TOKEN-COUNT).

    MOVE CURRENT-COLUMN
        TO TOKEN-COLUMN(TOKEN-COUNT).


ADD-ASSIGN-TOKEN.

    ADD 1 TO TOKEN-COUNT.

    MOVE TOKEN-ASSIGN
        TO TOKEN-KIND(TOKEN-COUNT).

    MOVE "="
        TO TOKEN-TEXT(TOKEN-COUNT).

    MOVE CURRENT-LINE
        TO TOKEN-LINE(TOKEN-COUNT).

    MOVE CURRENT-COLUMN
        TO TOKEN-COLUMN(TOKEN-COUNT).


ADD-PLUS-TOKEN.

    ADD 1 TO TOKEN-COUNT.

    MOVE TOKEN-PLUS
        TO TOKEN-KIND(TOKEN-COUNT).

    MOVE "+"
        TO TOKEN-TEXT(TOKEN-COUNT).

    MOVE CURRENT-LINE
        TO TOKEN-LINE(TOKEN-COUNT).

    MOVE CURRENT-COLUMN
        TO TOKEN-COLUMN(TOKEN-COUNT).


ADD-MINUS-TOKEN.

    ADD 1 TO TOKEN-COUNT.

    MOVE TOKEN-MINUS
        TO TOKEN-KIND(TOKEN-COUNT).

    MOVE "-"
        TO TOKEN-TEXT(TOKEN-COUNT).

    MOVE CURRENT-LINE
        TO TOKEN-LINE(TOKEN-COUNT).

    MOVE CURRENT-COLUMN
        TO TOKEN-COLUMN(TOKEN-COUNT).


ADD-MULTIPLY-TOKEN.

    ADD 1 TO TOKEN-COUNT.

    MOVE TOKEN-MULTIPLY
        TO TOKEN-KIND(TOKEN-COUNT).

    MOVE "*"
        TO TOKEN-TEXT(TOKEN-COUNT).

    MOVE CURRENT-LINE
        TO TOKEN-LINE(TOKEN-COUNT).

    MOVE CURRENT-COLUMN
        TO TOKEN-COLUMN(TOKEN-COUNT).


ADD-DIVIDE-TOKEN.

    ADD 1 TO TOKEN-COUNT.

    MOVE TOKEN-DIVIDE
        TO TOKEN-KIND(TOKEN-COUNT).

    MOVE "/"
        TO TOKEN-TEXT(TOKEN-COUNT).

    MOVE CURRENT-LINE
        TO TOKEN-LINE(TOKEN-COUNT).

    MOVE CURRENT-COLUMN
        TO TOKEN-COLUMN(TOKEN-COUNT).


ADD-LPAREN-TOKEN.

    ADD 1 TO TOKEN-COUNT.

    MOVE TOKEN-LPAREN
        TO TOKEN-KIND(TOKEN-COUNT).

    MOVE "("
        TO TOKEN-TEXT(TOKEN-COUNT).

    MOVE CURRENT-LINE
        TO TOKEN-LINE(TOKEN-COUNT).

    MOVE CURRENT-COLUMN
        TO TOKEN-COLUMN(TOKEN-COUNT).


ADD-RPAREN-TOKEN.

    ADD 1 TO TOKEN-COUNT.

    MOVE TOKEN-RPAREN
        TO TOKEN-KIND(TOKEN-COUNT).

    MOVE ")"
        TO TOKEN-TEXT(TOKEN-COUNT).

    MOVE CURRENT-LINE
        TO TOKEN-LINE(TOKEN-COUNT).

    MOVE CURRENT-COLUMN
        TO TOKEN-COLUMN(TOKEN-COUNT).


ADD-LBRACE-TOKEN.

    ADD 1 TO TOKEN-COUNT.

    MOVE TOKEN-LBRACE
        TO TOKEN-KIND(TOKEN-COUNT).

    MOVE "{"
        TO TOKEN-TEXT(TOKEN-COUNT).

    MOVE CURRENT-LINE
        TO TOKEN-LINE(TOKEN-COUNT).

    MOVE CURRENT-COLUMN
        TO TOKEN-COLUMN(TOKEN-COUNT).


ADD-RBRACE-TOKEN.

    ADD 1 TO TOKEN-COUNT.

    MOVE TOKEN-RBRACE
        TO TOKEN-KIND(TOKEN-COUNT).

    MOVE "}"
        TO TOKEN-TEXT(TOKEN-COUNT).

    MOVE CURRENT-LINE
        TO TOKEN-LINE(TOKEN-COUNT).

    MOVE CURRENT-COLUMN
        TO TOKEN-COLUMN(TOKEN-COUNT).


REPORT-LEXICAL-ERROR.

    DISPLAY "LEXICAL ERROR at line "
            CURRENT-LINE
            ", column "
            CURRENT-COLUMN
            ": unexpected character ["
            CURRENT-CHAR
            "]".

    MOVE "Y" TO LEXICAL-ERROR.


EXPORT-TOKENS.

    MOVE TOKEN-COUNT
        TO OUTPUT-TOKEN-COUNT

    PERFORM VARYING CURRENT-POSITION
        FROM 1 BY 1
        UNTIL CURRENT-POSITION > TOKEN-COUNT

        MOVE TOKEN-KIND(CURRENT-POSITION)
            TO OUTPUT-TOKEN-KIND(CURRENT-POSITION)

        MOVE TOKEN-TEXT(CURRENT-POSITION)
            TO OUTPUT-TOKEN-TEXT(CURRENT-POSITION)

        MOVE TOKEN-LINE(CURRENT-POSITION)
            TO OUTPUT-TOKEN-LINE(CURRENT-POSITION)

        MOVE TOKEN-COLUMN(CURRENT-POSITION)
            TO OUTPUT-TOKEN-COLUMN(CURRENT-POSITION)

    END-PERFORM.

DISPLAY-TOKENS.

    PERFORM VARYING CURRENT-POSITION
        FROM 1 BY 1
        UNTIL CURRENT-POSITION > TOKEN-COUNT

        DISPLAY
            "Token "
            CURRENT-POSITION
            " | Type="
            TOKEN-KIND(CURRENT-POSITION)
            " | Text=["
            FUNCTION TRIM(TOKEN-TEXT(CURRENT-POSITION))
            "]"

    END-PERFORM.
