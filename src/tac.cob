       >>SOURCE FORMAT IS FREE
IDENTIFICATION DIVISION.
PROGRAM-ID. TAC.

DATA DIVISION.
WORKING-STORAGE SECTION.
    01 T-I PIC 9(4).
    01 T-J PIC 9(4).
    01 T-NODE PIC 9(4).
    01 T-EXPR-ROOT PIC 9(4).
    01 T-EXPR-START PIC 9(4).
    01 T-CURRENT-STMT PIC 9(4).
    01 T-DEPTH PIC 9(3).
    01 T-FRAMES.
       05 T-FRAME OCCURS 100 TIMES.
          10 T-FRAME-NEXT PIC 9(4).
          10 T-FRAME-CONTROL PIC 9(4).
          10 T-FRAME-PHASE PIC 9.
          10 T-FRAME-START PIC X(8).
          10 T-FRAME-END PIC X(8).
          10 T-FRAME-ALT PIC X(8).
          10 T-FRAME-ELSE-BLOCK PIC 9(4).
    01 T-NODE-RESULTS.
       05 T-NODE-RESULT OCCURS 5000 TIMES PIC X(64).
    01 T-NEW-TEMP PIC X(64).
    01 T-TEMP-EDIT PIC 9(4).
    01 T-LABEL PIC X(8).
    01 T-LABEL-EDIT PIC 9(4).
    01 T-ALT-LABEL-SAVE PIC X(8).
    01 T-END-LABEL-SAVE PIC X(8).
    01 T-START-LABEL-SAVE PIC X(8).
    01 T-IR-OP PIC X(8).
    01 T-IR-ARG1 PIC X(64).
    01 T-IR-ARG2 PIC X(64).
    01 T-IR-RESULT PIC X(64).
    01 T-LEFT-ID PIC 9(4).
    01 T-RIGHT-ID PIC 9(4).
    01 T-CONTROL-ID PIC 9(4).
    01 T-NEXT-STMT PIC 9(4).
    01 T-ALT-BLOCK PIC 9(4).
LINKAGE SECTION.
    COPY "compiler-state.cpy".
PROCEDURE DIVISION USING COMPILER-STATE.
MAIN-TAC.
    MOVE 0 TO CS-IR-COUNT CS-TEMP-COUNT CS-LABEL-COUNT
    INITIALIZE T-NODE-RESULTS T-FRAMES
    MOVE CS-AST-LEFT(CS-AST-ROOT) TO T-CURRENT-STMT
    MOVE 0 TO T-DEPTH

    PERFORM UNTIL (T-CURRENT-STMT = 0 AND T-DEPTH = 0)
       OR CS-ERROR-FLAG = "Y"
        IF T-CURRENT-STMT = 0
            PERFORM T-CLOSE-BLOCK
        ELSE
            MOVE T-CURRENT-STMT TO T-CONTROL-ID
            MOVE CS-AST-NEXT(T-CURRENT-STMT) TO T-NEXT-STMT
            EVALUATE TRUE
                WHEN FUNCTION TRIM(CS-AST-TYPE(T-CURRENT-STMT)) = "VAR-DECL"
                  OR FUNCTION TRIM(CS-AST-TYPE(T-CURRENT-STMT)) = "ASSIGN"
                    MOVE CS-AST-LEFT(T-CURRENT-STMT) TO T-EXPR-ROOT
                    PERFORM T-GENERATE-EXPRESSION
                    MOVE "MOV" TO T-IR-OP
                    MOVE T-NODE-RESULT(T-EXPR-ROOT) TO T-IR-ARG1
                    MOVE SPACES TO T-IR-ARG2
                    MOVE CS-AST-VALUE(T-CONTROL-ID) TO T-IR-RESULT
                    PERFORM T-APPEND-IR
                    MOVE T-NEXT-STMT TO T-CURRENT-STMT
                WHEN FUNCTION TRIM(CS-AST-TYPE(T-CURRENT-STMT)) = "PRINT"
                    MOVE CS-AST-LEFT(T-CURRENT-STMT) TO T-EXPR-ROOT
                    PERFORM T-GENERATE-EXPRESSION
                    MOVE "PRINT" TO T-IR-OP
                    MOVE T-NODE-RESULT(T-EXPR-ROOT) TO T-IR-ARG1
                    MOVE SPACES TO T-IR-ARG2 T-IR-RESULT
                    PERFORM T-APPEND-IR
                    MOVE T-NEXT-STMT TO T-CURRENT-STMT
                WHEN FUNCTION TRIM(CS-AST-TYPE(T-CURRENT-STMT)) = "IF"
                    PERFORM T-GENERATE-IF
                WHEN FUNCTION TRIM(CS-AST-TYPE(T-CURRENT-STMT)) = "WHILE"
                    PERFORM T-GENERATE-WHILE
                WHEN OTHER
                    MOVE "Unknown AST statement in TAC generation." TO CS-ERROR-MESSAGE
                    MOVE "Y" TO CS-ERROR-FLAG
            END-EVALUATE
        END-IF
    END-PERFORM

    GOBACK.

T-GENERATE-IF.
    MOVE CS-AST-LEFT(T-CONTROL-ID) TO T-EXPR-ROOT
    PERFORM T-GENERATE-EXPRESSION
    MOVE T-NODE-RESULT(T-EXPR-ROOT) TO T-IR-ARG1
    MOVE SPACES TO T-IR-ARG2 T-IR-RESULT
    MOVE CS-AST-THIRD(T-CONTROL-ID) TO T-ALT-BLOCK
    IF T-ALT-BLOCK NOT = 0
        PERFORM T-MAKE-LABEL
        MOVE T-LABEL TO T-IR-RESULT
        MOVE T-LABEL TO T-ALT-LABEL-SAVE
        PERFORM T-MAKE-LABEL
        MOVE T-LABEL TO T-END-LABEL-SAVE
    ELSE
        PERFORM T-MAKE-LABEL
        MOVE T-LABEL TO T-END-LABEL-SAVE
        MOVE SPACES TO T-ALT-LABEL-SAVE
        MOVE T-LABEL TO T-IR-RESULT
    END-IF
    MOVE "IFZ" TO T-IR-OP
    PERFORM T-APPEND-IR
    IF T-DEPTH >= 100
        MOVE "TAC control-flow nesting exceeds 100." TO CS-ERROR-MESSAGE
        MOVE "Y" TO CS-ERROR-FLAG
        EXIT PARAGRAPH
    END-IF
    ADD 1 TO T-DEPTH
    MOVE T-NEXT-STMT TO T-FRAME-NEXT(T-DEPTH)
    MOVE T-CONTROL-ID TO T-FRAME-CONTROL(T-DEPTH)
    MOVE 1 TO T-FRAME-PHASE(T-DEPTH)
    MOVE T-END-LABEL-SAVE TO T-FRAME-END(T-DEPTH)
    MOVE T-ALT-LABEL-SAVE TO T-FRAME-ALT(T-DEPTH)
    MOVE T-ALT-BLOCK TO T-FRAME-ELSE-BLOCK(T-DEPTH)
    MOVE SPACES TO T-FRAME-START(T-DEPTH)
    MOVE CS-AST-LEFT(CS-AST-RIGHT(T-CONTROL-ID)) TO T-CURRENT-STMT.

T-GENERATE-WHILE.
    PERFORM T-MAKE-LABEL
    MOVE T-LABEL TO T-START-LABEL-SAVE
    MOVE "LABEL" TO T-IR-OP
    MOVE SPACES TO T-IR-ARG1 T-IR-ARG2
    MOVE T-START-LABEL-SAVE TO T-IR-RESULT
    PERFORM T-APPEND-IR
    MOVE CS-AST-LEFT(T-CONTROL-ID) TO T-EXPR-ROOT
    PERFORM T-GENERATE-EXPRESSION
    MOVE "IFZ" TO T-IR-OP
    MOVE T-NODE-RESULT(T-EXPR-ROOT) TO T-IR-ARG1
    MOVE SPACES TO T-IR-ARG2
    PERFORM T-MAKE-LABEL
    MOVE T-LABEL TO T-END-LABEL-SAVE
    MOVE T-END-LABEL-SAVE TO T-IR-RESULT
    PERFORM T-APPEND-IR
    IF T-DEPTH >= 100
        MOVE "TAC control-flow nesting exceeds 100." TO CS-ERROR-MESSAGE
        MOVE "Y" TO CS-ERROR-FLAG
        EXIT PARAGRAPH
    END-IF
    ADD 1 TO T-DEPTH
    MOVE T-NEXT-STMT TO T-FRAME-NEXT(T-DEPTH)
    MOVE T-CONTROL-ID TO T-FRAME-CONTROL(T-DEPTH)
    MOVE 3 TO T-FRAME-PHASE(T-DEPTH)
    MOVE T-START-LABEL-SAVE TO T-FRAME-START(T-DEPTH)
    MOVE T-END-LABEL-SAVE TO T-FRAME-END(T-DEPTH)
    MOVE SPACES TO T-FRAME-ALT(T-DEPTH)
    MOVE 0 TO T-FRAME-ELSE-BLOCK(T-DEPTH)
    MOVE CS-AST-LEFT(CS-AST-RIGHT(T-CONTROL-ID)) TO T-CURRENT-STMT.

T-CLOSE-BLOCK.
    IF T-DEPTH = 0
        MOVE 0 TO T-CURRENT-STMT
        EXIT PARAGRAPH
    END-IF
    EVALUATE T-FRAME-PHASE(T-DEPTH)
        WHEN 1
            IF T-FRAME-ELSE-BLOCK(T-DEPTH) NOT = 0
                MOVE "JMP" TO T-IR-OP
                MOVE SPACES TO T-IR-ARG1 T-IR-ARG2
                MOVE T-FRAME-END(T-DEPTH) TO T-IR-RESULT
                PERFORM T-APPEND-IR
                MOVE "LABEL" TO T-IR-OP
                MOVE SPACES TO T-IR-ARG1 T-IR-ARG2
                MOVE T-FRAME-ALT(T-DEPTH) TO T-IR-RESULT
                PERFORM T-APPEND-IR
                MOVE 2 TO T-FRAME-PHASE(T-DEPTH)
                MOVE CS-AST-LEFT(T-FRAME-ELSE-BLOCK(T-DEPTH))
                  TO T-CURRENT-STMT
            ELSE
                MOVE "LABEL" TO T-IR-OP
                MOVE SPACES TO T-IR-ARG1 T-IR-ARG2
                MOVE T-FRAME-END(T-DEPTH) TO T-IR-RESULT
                PERFORM T-APPEND-IR
                MOVE T-FRAME-NEXT(T-DEPTH) TO T-CURRENT-STMT
                SUBTRACT 1 FROM T-DEPTH
            END-IF
        WHEN 2
            MOVE "LABEL" TO T-IR-OP
            MOVE SPACES TO T-IR-ARG1 T-IR-ARG2
            MOVE T-FRAME-END(T-DEPTH) TO T-IR-RESULT
            PERFORM T-APPEND-IR
            MOVE T-FRAME-NEXT(T-DEPTH) TO T-CURRENT-STMT
            SUBTRACT 1 FROM T-DEPTH
        WHEN 3
            MOVE "JMP" TO T-IR-OP
            MOVE SPACES TO T-IR-ARG1 T-IR-ARG2
            MOVE T-FRAME-START(T-DEPTH) TO T-IR-RESULT
            PERFORM T-APPEND-IR
            MOVE "LABEL" TO T-IR-OP
            MOVE SPACES TO T-IR-ARG1 T-IR-ARG2
            MOVE T-FRAME-END(T-DEPTH) TO T-IR-RESULT
            PERFORM T-APPEND-IR
            MOVE T-FRAME-NEXT(T-DEPTH) TO T-CURRENT-STMT
            SUBTRACT 1 FROM T-DEPTH
        WHEN OTHER
            MOVE "Invalid TAC traversal state." TO CS-ERROR-MESSAGE
            MOVE "Y" TO CS-ERROR-FLAG
    END-EVALUATE.

T-GENERATE-EXPRESSION.
    MOVE CS-AST-FIRST(T-EXPR-ROOT) TO T-EXPR-START
    PERFORM VARYING T-NODE FROM T-EXPR-START BY 1
        UNTIL T-NODE > T-EXPR-ROOT OR CS-ERROR-FLAG = "Y"
        EVALUATE TRUE
            WHEN FUNCTION TRIM(CS-AST-TYPE(T-NODE)) = "INTEGER"
              OR FUNCTION TRIM(CS-AST-TYPE(T-NODE)) = "IDENTIFIER"
                MOVE CS-AST-VALUE(T-NODE) TO T-NODE-RESULT(T-NODE)
            WHEN FUNCTION TRIM(CS-AST-TYPE(T-NODE)) = "BINARY-EXPR"
                MOVE CS-AST-LEFT(T-NODE) TO T-LEFT-ID
                MOVE CS-AST-RIGHT(T-NODE) TO T-RIGHT-ID
                PERFORM T-MAKE-TEMP
                MOVE T-NEW-TEMP TO T-NODE-RESULT(T-NODE)
                MOVE T-NODE-RESULT(T-LEFT-ID) TO T-IR-ARG1
                MOVE T-NODE-RESULT(T-RIGHT-ID) TO T-IR-ARG2
                MOVE T-NEW-TEMP TO T-IR-RESULT
                EVALUATE FUNCTION TRIM(CS-AST-VALUE(T-NODE))
                    WHEN "+" MOVE "ADD" TO T-IR-OP
                    WHEN "-" MOVE "SUB" TO T-IR-OP
                    WHEN "*" MOVE "MUL" TO T-IR-OP
                    WHEN "/" MOVE "DIV" TO T-IR-OP
                    WHEN "==" MOVE "EQ" TO T-IR-OP
                    WHEN "!=" MOVE "NE" TO T-IR-OP
                    WHEN "<" MOVE "LT" TO T-IR-OP
                    WHEN ">" MOVE "GT" TO T-IR-OP
                    WHEN "<=" MOVE "LE" TO T-IR-OP
                    WHEN ">=" MOVE "GE" TO T-IR-OP
                    WHEN OTHER
                        MOVE "Unknown binary operator in AST." TO CS-ERROR-MESSAGE
                        MOVE "Y" TO CS-ERROR-FLAG
                END-EVALUATE
                PERFORM T-APPEND-IR
            WHEN OTHER
                CONTINUE
        END-EVALUATE
    END-PERFORM.

T-MAKE-TEMP.
    ADD 1 TO CS-TEMP-COUNT
    MOVE SPACES TO T-NEW-TEMP
    MOVE CS-TEMP-COUNT TO T-TEMP-EDIT
    STRING "@T" DELIMITED BY SIZE
           T-TEMP-EDIT DELIMITED BY SIZE
           INTO T-NEW-TEMP
    END-STRING.

T-MAKE-LABEL.
    ADD 1 TO CS-LABEL-COUNT
    MOVE SPACES TO T-LABEL
    MOVE CS-LABEL-COUNT TO T-LABEL-EDIT
    STRING "L" DELIMITED BY SIZE
           T-LABEL-EDIT DELIMITED BY SIZE
           INTO T-LABEL
    END-STRING.

T-APPEND-IR.
    IF CS-IR-COUNT >= 5000
        MOVE "Intermediate-code capacity exceeded (5000 instructions)." TO CS-ERROR-MESSAGE
        MOVE "Y" TO CS-ERROR-FLAG
        EXIT PARAGRAPH
    END-IF
    ADD 1 TO CS-IR-COUNT
    MOVE T-IR-OP TO CS-IR-OP(CS-IR-COUNT)
    MOVE T-IR-ARG1 TO CS-IR-ARG1(CS-IR-COUNT)
    MOVE T-IR-ARG2 TO CS-IR-ARG2(CS-IR-COUNT)
    MOVE T-IR-RESULT TO CS-IR-RESULT(CS-IR-COUNT).
